DATABASE_URL=mongodb://admin:admin@university-project-db:27017/
# DATABASE_URL=mongodb://localhost:27017/
REDIS_URL=redis://redis:6379/0

# Token and Authentication settings
SECRET_KEY=change-me-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=replace-with-a-demo-password

# SMTP Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SENDER_EMAIL=your-email@example.com

# ZarinPal Configuration
MERCHANT=your-zarinpal-merchant-id
ZP_API_REQUEST=https://api.zarinpal.com/pg/v4/payment/request.json
ZP_API_VERIFY=https://api.zarinpal.com/pg/v4/payment/verify.json
ZP_API_STARTPAY=https://www.zarinpal.com/pg/StartPay/{authority}
DESCRIPTION=None

# Frontend Configuration
FRONTEND_SERVER_URL=http://localhost

# Optional Google OAuth configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8002/auth/callback

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_S3_ENDPOINT_URL=s3.ir-thr-at1.arvanstorage.ir
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_SERVICE_NAME=s3
OVERWRITE_EXISTING_FILES=False
